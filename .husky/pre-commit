#!/bin/sh
# Husky pre-commit hook
# Chạy kiểm tra nhanh TRƯỚC KHI commit để bắt lỗi sớm nhất có thể
# Tham khảo: .agents/workflows/references/commit-hook-guide.md

export PATH="$PATH:/c/Program Files/nodejs:/c/Users/dinhp/AppData/Roaming/npm:node_modules/.bin"

echo "🔍 [pre-commit] Chạy TypeScript type-check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ [pre-commit] TypeScript errors found. Sửa lỗi trước khi commit."
  exit 1
fi

echo "🔍 [pre-commit] Chạy ESLint..."
npx eslint --quiet
if [ $? -ne 0 ]; then
  echo "❌ [pre-commit] ESLint errors found. Sửa lỗi trước khi commit."
  exit 1
fi

echo "✅ [pre-commit] Tất cả kiểm tra qua! Đang commit..."
